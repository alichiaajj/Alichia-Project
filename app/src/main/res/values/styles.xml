<resources>
<style name="AppThemeBase" parent="android:style/Theme.Material.Light.NoActionBar">
<item name="android:fontFamily">@font/inter</item><item name="android:colorAccent">@color/teal</item><item name="android:windowLightStatusBar">true</item><item name="android:statusBarColor">@color/cream</item><item name="android:navigationBarColor">@color/teal</item><item name="android:windowActionModeOverlay">true</item><item name="android:windowBackground">@color/cream</item>
</style>
<style name="AppTheme" parent="AppThemeBase"/>
<style name="Title"><item name="android:textSize">23sp</item><item name="android:textStyle">bold</item><item name="android:textColor">@color/dark</item><item name="android:fontFamily">@font/poppins_semibold</item></style>
<style name="Body"><item name="android:textSize">14sp</item><item name="android:textColor">@color/muted</item><item name="android:lineSpacingExtra">4dp</item></style>
<style name="Primary"><item name="android:background">@drawable/bg_primary</item><item name="android:textColor">#FFFFFF</item><item name="android:textAllCaps">false</item><item name="android:textStyle">bold</item><item name="android:minHeight">48dp</item><item name="android:paddingLeft">18dp</item><item name="android:paddingRight">18dp</item><item name="android:stateListAnimator">@null</item></style>
</resources>
